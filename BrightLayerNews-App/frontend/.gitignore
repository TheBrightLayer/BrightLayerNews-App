# ==========================================================
# FRONTEND (React Native / Expo) .gitignore
# Monorepo setup: ignore backend + its dependencies
# ==========================================================

# --- Ignore backend (since we have a separate branch/repo) ---
../backend
../backend/*
../backend/node_modules

# --- Dependencies ---
node_modules/
package-lock.json
yarn.lock

# --- Expo specific ---
.expo/
.expo-shared/
.expo/web-cache/
dist/
web-build/
expo-env.d.ts

# --- Native (Android / iOS) builds ---
ios/
android/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
.kotlin/

# --- Metro bundler ---
.metro-health-check*

# --- Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# --- macOS / Windows system files ---
.DS_Store
Thumbs.db
*.pem

# --- Local environment files ---
.env
.env*.local

# --- TypeScript build artifacts ---
*.tsbuildinfo
*.d.ts

# --- IDE / Editor settings ---
.vscode/
.idea/

# --- Misc ---
*.iml
*.tmp
